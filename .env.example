# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Database
# Local development may use SQLite. Production must use an absolute SQLite
# path (or a separately managed DATABASE_URL) and must never use committed
# credentials.
DATABASE_URL=sqlite:///./coloremotionstudy.db
# Administrative authentication secret. Leave empty locally unless needed.
# Never commit a real token.
ADMIN_API_TOKEN=

# Completion notification (disabled by default)
NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFICATION_OPERATOR_RECIPIENT=
NOTIFICATION_TECHNICAL_RECIPIENT=
# Use either SMTP_USE_SSL=true or SMTP_STARTTLS=true, not both.
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT=10
